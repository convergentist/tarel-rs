
# ------------------------------------------------------------------------------------- #
# .env
# Environment Variables for both stage-one and stage-two execution
# Currently supporting two options: 
# - m4 : Apple silicon + CPU-only
# - linux : Ubuntu + Nvidia GPU
# ------------------------------------------------------------------------------------- #

# --- PLATFORM ARCHITECTURE: Support for <linux, mac>

STG_ONE_IMAGE=tarel-rs:linux-cuda-x86-stage-one
STG_ONE_DOCKER_FILE=linux-cuda-x86-stage-one.Dockerfile
STG_ONE_PLATFORM=linux/amd64

STG_TWO_IMAGE=tarel-rs:linux-cuda-x86-stage-two
STG_TWO_DOCKER_FILE=linux-cuda-x86-stage-two.Dockerfile
STG_TWO_PLATFORM=linux/amd64

# --- PLATFORM ARCHITECTURE: macOS

# STG_ONE_IMAGE=tarel-rs:m4-stage-one
# STG_ONE_DOCKER_FILE_=m4-stage-one
# STG_ONE_PLATFORM=linux/arm64

# STG_TWO_IMAGE=tarel-rs:m4-stage-two
# STG_TWO_DOCKER_FILE=m4-stage-two
# STG_TWO_PLATFORM=linux/arm64

# --- GENERIC ---

EXCHANGE=kraken
SYMBOL=BTC-USDC
CELL=$EXCHANGE:$SYMBOL
INPUT_PARQUET=/work/tarel/datasets/consolidated/$EXCHANGE/$SYMBOL.parquet
OUTPUT_RUNS=/work/tarel/artifacts/runs

# --- STAGE RELATED ---

STG_ONE_EXP=2026052210000
STG_ONE_SEED=2

STG_TWO_EXP=2026052210000
STG_TWO_SEED=2
STG_TWO_RUN_MINS=10
STG_TWO_CLOCKS=physical

